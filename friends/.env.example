# Dibs Friends server. Copy to .env for local runs. Never commit a real .env.
# Values are typed in Render's dashboard in production, never in the repo or in chat.

# Port to listen on (Render sets this for you).
PORT=

# Comma-separated HTTPS origins allowed to call /v1/* (the app's address).
# Empty in development means CORS is open; empty in production means CORS is closed.
ALLOWED_ORIGINS=

# This service's OWN Upstash Redis database (not the stats one). Both must be set to use Upstash;
# otherwise an in-memory store is used and data is not kept across restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to turn a wallet address into the walletKey that links a wallet to a user.
# Make it with a password manager. NEVER rotate it: rotating unlinks every wallet.
# Required in production (the server refuses to start without it).
FRIENDS_SALT=

# production | development. In production FRIENDS_SALT is required and CORS is closed when no origins are set.
NODE_ENV=
