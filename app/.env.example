# Validator new stakers delegate to (NQ.. address). Pick one together, see STATUS.md.
VITE_DEFAULT_VALIDATOR=

# Nimiq JSON-RPC endpoint used for staker reads. Leave empty to skip RPC reads.
VITE_NIMIQ_RPC_URL=

# Redeem mode: "manual" (paste invoice from the shop page) or "api" (our server creates the order)
VITE_REDEEM_MODE=api

# Server base URL. Empty = same origin (/api is proxied to localhost:8787 in dev).
VITE_API_URL=

# Used only if the live NIM price cannot be fetched.
VITE_FALLBACK_NIM_USD=0.0003
