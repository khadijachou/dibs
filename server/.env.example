PORT=8787

# Bitrefill MCP access (OAuth client credentials). Register a client once with
# POST https://api.bitrefill.com/oauth/mcp/register (see README). NEVER commit the real values.
BITREFILL_CLIENT_ID=
BITREFILL_CLIENT_SECRET=
BITREFILL_MCP_URL=https://api.bitrefill.com/mcp
BITREFILL_TOKEN_URL=https://api.bitrefill.com/oauth/mcp/token

# Optional affiliate code from bitrefill.com/integrate (commission only, changes nothing for the buyer).
BITREFILL_AFFILIATE_ID=

# Comma-separated origins allowed to call the API (your HTTPS app URL). Empty = same origin only.
ALLOWED_ORIGINS=
